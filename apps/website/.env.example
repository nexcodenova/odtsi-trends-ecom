NEXT_PUBLIC_EXIUSCART_API_URL=https://api.exiuscart.com/api/v1
NEXT_PUBLIC_SHOP_SLUG=odtsi

# Retargeting — both optional. Leave blank and neither pixel loads at all
# (no placeholder ID, no broken script, just silently off). Get a real
# Meta Pixel ID from Meta Events Manager, and a real Google Ads ID
# (format AW-XXXXXXXXX) from Google Ads > Tools > Conversions.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
